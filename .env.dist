# Copy to .env at the repo root and fill in real values. NEVER commit .env.
#
# Deutsche Bahn API Marketplace credentials for the Shared-Mobility GBFS API,
# used by the GBFS poller (scripts/gbfs_poller.py, and the `poller` container in
# deploy/web/docker-compose.yml). Register a free app and subscribe to the
# "Shared Mobility" API at https://developers.deutschebahn.com/ — the app's
# Client ID / API key map to these two keys (lowercase, as loaded by the poller).
clientid=
clientsecret=

# Web/runtime tuning is configured in deploy/web/docker-compose.yml (and
# web/settings.py), not here — e.g. DATA_DIR, DUCKDB_THREADS, TRIP_REFRESH_SEC,
# RATE_GLOBAL / RATE_HISTORY / RATE_DOWNLOAD, CORS_ORIGINS.
